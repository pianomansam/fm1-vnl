# SPDX-License-Identifier: MPL-2.0
# VNL-1 plays a whole generated song, a silent gap of 2-4 s, then the next song. Writes songs.wav (listen to it).
#   app/build/host/vnl_host tests/scenarios/songs.vnl app/build/scenarios
#   VNL_SCORE=app/build/scenarios/songs ... writes songs.log, songs-N.mid, songs-N.musicxml (tests/run_tests.sh does):
#   the log's times are times in songs.wav, which records from boot
wav songs.wav
# MASTER all the way up (the simulator starts it at half: -12 dB), so songs.wav has the engine's own level
master 4096
wait 1000
expect playing 1
expect songs 1
shot now.png
peakreset
# a song lasts at most 210 s and the gap at most 4 s; the next song lasts at least 120 s
wait 215000
expect songs 2
expect playing 1
wavstop
# heard near -6 dBFS, and never past full scale
expect peak_db_min -9
expect peak_db_max <0
