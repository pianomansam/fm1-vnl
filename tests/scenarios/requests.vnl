# SPDX-License-Identifier: GPL-3.0-or-later
# A knob's change waits for the next 4-bar boundary, then lands.
wait 1400
# the home: DETAILED, the main screen (Settings' HOME SCREEN, its third line; a fresh device's is now playing)
tap GLO
wait 50
spin SELECT 2
turn K1 1
tap GLO
wait 50
tap PLAY
wait 2000
expect pending -1
# K1: the key +3 semitones (the key wraps, so this is a change whatever song 1 is; tempo, motion and mood stop
# at their ends)
turn K1 3
expect pending >0
shot pending.png
# 4 bars at the slowest tempo (70 BPM) last 13715 ms: past the next boundary by then
wait 14000
expect pending -1
