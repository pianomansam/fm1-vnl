# The manual's screenshots (app/docs/MANUAL.md); not a test. After ./build.sh --host:
#   app/build/host/vnl-1_host app/docs/shots.vnl app/build/shots
# then copy app/build/shots/vnl-*.png to app/docs/img/, saved as palette PNGs (each has under 256 colors: lossless).
wait 600
shot vnl-splash.png
wait 1000
tap PLAY
wait 9000
shot vnl-now.png
# the home set to the main screen (Settings' HOME SCREEN DETAILED; a fresh device's is now playing), for the shots
# that follow
tap GLO
wait 50
spin SELECT 2
turn K1 1
tap GLO
wait 50
shot vnl-main.png
# a change waiting for the next four-bar line
spin K2 3
wait 50
shot vnl-pending.png
tap EDIT
wait 50
shot vnl-song.png
spin SELECT 1
spin SELECT 1
spin ALGO 1
wait 50
shot vnl-drums.png
spin ALGO 1
wait 50
shot vnl-bass.png
spin ALGO 1
wait 50
shot vnl-comp.png
spin SELECT 1
spin ALGO 1
wait 50
shot vnl-lead.png
spin ALGO 1
wait 50
shot vnl-pad.png
spin ALGO 1
wait 50
shot vnl-texture.png
tap HOME
wait 50
tap SEL
wait 50
shot vnl-sections.png
tap SEL
tap ARP
wait 2000
shot vnl-parts.png
tap ARP
tap FX
wait 50
shot vnl-mixer.png
tap FX
tap GLO
wait 50
# HOME SCREEN (highlighted) at its default for the shot, SIMPLE; then DETAILED again
turn K1 1
wait 50
shot vnl-settings.png
turn K1 1
# a locked part (Locking): the drums' tile highlighted, SEQ held, then its screen
tap GLO
wait 50
spin ALGO 1
press SEQ
wait 700
release SEQ
tap EDIT
wait 50
shot vnl-lock.png
# the song line locked (the song tile highlighted, SEQ held), then its screen
tap EDIT
wait 50
spin ALGO -1
press SEQ
wait 700
release SEQ
tap EDIT
wait 50
shot vnl-lock-song.png
# saving the song (Saving songs): SAVE on the Song screen ("SAVED TO 1" in the header), then REC: the Saved list
tap SAVE
wait 50
shot vnl-saved-to.png
tap REC
wait 50
shot vnl-saved.png
